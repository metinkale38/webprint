# Admin-Bootstrap (nur beim ersten Start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Sicherheit
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false

# Daten (Container-Pfade)
DATABASE_URL=sqlite:////app/data/app.db
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_MB=50

# Discovery
DISCOVERY_SUBNETS=192.168.1.0/24
DISCOVERY_INTERVAL=300

# Zeitzone
TIMEZONE=Europe/Berlin

# CUPS (optional, fuer CUPS-WebUI)
CUPS_ADMIN=printadmin
CUPS_PASSWORD=change-me-too

# Virtueller PDF-Drucker (leer = deaktiviert; z. B. printtool-pdf fuer E2E)
CUPS_PDF_QUEUE=
